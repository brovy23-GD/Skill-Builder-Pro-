<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SkillBuilderPro.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SkillBuilderPro.MAUI.Views"
    Title="SkillBuilderPro">

    <TabBar>

        <ShellContent
            Title="Home" Route="Home" ContentTemplate="{DataTemplate views:AthleteDashboardPage}" />

        <ShellContent
            Title="Training" Route="Training" ContentTemplate="{DataTemplate views:TrainingPage}" />
        <ShellContent Title="Goals" Route="Goals" ContentTemplate="{DataTemplate views:GoalsPage}" />
        <ShellContent Title="Trophy" Route="Trophy" ContentTemplate="{DataTemplate views:TrophyRoomPage}" />
        <ShellContent Title="Profile" Route="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" />

    </TabBar>
</Shell>
