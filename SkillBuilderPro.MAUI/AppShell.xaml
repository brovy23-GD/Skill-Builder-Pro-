<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SkillBuilderPro.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SkillBuilderPro.MAUI"
    xmlns:views="clr-namespace:SkillBuilderPro.MAUI.Views"
    Title="SkillBuilderPro">

    <TabBar>

        <ShellContent
            Title="Home"
            Route="MainPage"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="Sports"
            Route="SportListPage"
            ContentTemplate="{DataTemplate views:SportListPage}" />

    </TabBar>
</Shell>