<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SkillBuilderPro.MAUI.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    BackgroundColor="#080B14">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="22"
            MaximumWidthRequest="960"
            HorizontalOptions="Center">

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="SKILLBUILDER PRO"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="#3B82F6"
                    CharacterSpacing="1.5" />

                <Label
                    Text="Train with purpose."
                    FontSize="34"
                    FontAttributes="Bold"
                    TextColor="#F8FAFC" />

                <Label
                    Text="Build better skills through focused, sport-specific training."
                    FontSize="17"
                    TextColor="#94A3B8" />
            </VerticalStackLayout>

            <Border
                BackgroundColor="#101827"
                Stroke="#253047"
                StrokeThickness="1"
                Padding="24">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <Grid
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="14">

                    <Label
                        Grid.Row="0"
                        Text="TRAINING LIBRARY"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#94A3B8"
                        CharacterSpacing="1.2" />

                    <Label
                        Grid.Row="1"
                        Text="Choose your sport and start training."
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Button
                        Grid.Row="2"
                        Text="Browse Sports"
                        Clicked="OnBrowseSportsClicked"
                        BackgroundColor="#1689E8"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        CornerRadius="12"
                        HorizontalOptions="Start"
                        Padding="24,0" />
                </Grid>
            </Border>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="14">

                <Border
                    Grid.Column="0"
                    BackgroundColor="#111827"
                    Stroke="#253047"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="01"
                            FontSize="13"
                            TextColor="#3B82F6"
                            FontAttributes="Bold" />

                        <Label
                            Text="Select a sport"
                            FontSize="17"
                            TextColor="White"
                            FontAttributes="Bold" />

                        <Label
                            Text="Browse your available athletic disciplines."
                            FontSize="13"
                            TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    BackgroundColor="#111827"
                    Stroke="#253047"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="02"
                            FontSize="13"
                            TextColor="#3B82F6"
                            FontAttributes="Bold" />

                        <Label
                            Text="Choose a drill"
                            FontSize="17"
                            TextColor="White"
                            FontAttributes="Bold" />

                        <Label
                            Text="Train by category and subcategory."
                            FontSize="13"
                            TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border
                BackgroundColor="#0F172A"
                Stroke="#1E293B"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="YOUR TRAINING WORKSPACE"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#94A3B8"
                        CharacterSpacing="1.1" />

                    <Label
                        Text="Use the Sports tab to access the complete drill library."
                        FontSize="15"
                        TextColor="#CBD5E1" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>