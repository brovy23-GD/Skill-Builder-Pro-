<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SkillBuilderPro.MAUI.Views.AthleteDashboardPage" Title="Home">
 <Grid BackgroundColor="#080C12">
  <Image Source="home_background_approved.png" Aspect="AspectFill" Opacity="1" ZIndex="-2" HorizontalOptions="Fill" VerticalOptions="Fill" SemanticProperties.Description="Skill Builder Pro performance facility"/>
  <BoxView Color="#16050A10" ZIndex="-1"/>
  <ScrollView><VerticalStackLayout Padding="28,24,28,36" Spacing="18" MaximumWidthRequest="1100" HorizontalOptions="Center">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
    <VerticalStackLayout Spacing="2">
     <Label Text="WELCOME BACK" Style="{StaticResource PageEyebrowStyle}"/>
     <Label Text="{Binding DisplayName}" Style="{StaticResource PageTitleStyle}" TextTransform="Uppercase"/>
     <Label Text="{Binding AthleteDescriptor}" Style="{StaticResource PageSubtitleStyle}"/>
    </VerticalStackLayout>
    <Grid Grid.Column="1" VerticalOptions="Center"><Button Text="NOTIFICATIONS" Clicked="BellClicked" Style="{StaticResource EliteButtonStyle}" SemanticProperties.Description="Open notifications"/><Label Text="{Binding UnreadCount}" IsVisible="{Binding HasUnreadNotifications}" Style="{StaticResource GlassBadgeStyle}" FontSize="9" HorizontalOptions="End" VerticalOptions="Start"/></Grid>
   </Grid>
   <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Stretch" Direction="Row">
    <Border Style="{StaticResource EliteMetricStyle}" Margin="0,0,8,8"><VerticalStackLayout><Label Text="CURRENT RANK" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding Progression.OverallRank}" Style="{StaticResource HomeMetricValueStyle}" HorizontalTextAlignment="Start"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource EliteMetricStyle}" Margin="0,0,8,8"><VerticalStackLayout><Label Text="STREAK" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding Progression.CurrentStreak, StringFormat='{0} DAYS'}" Style="{StaticResource HomeMetricValueStyle}" HorizontalTextAlignment="Start"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource EliteMetricStyle}" Margin="0,0,8,8"><VerticalStackLayout><Label Text="ACTIVE GOALS" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding Goals.Count}" Style="{StaticResource HomeMetricValueStyle}" HorizontalTextAlignment="Start"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource EliteMetricStyle}" Margin="0,0,8,8"><VerticalStackLayout><Label Text="NOTIFICATIONS" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding UnreadCount}" Style="{StaticResource HomeMetricValueStyle}" HorizontalTextAlignment="Start"/></VerticalStackLayout></Border>
   </FlexLayout>
   <Border Style="{StaticResource EliteSurfaceStyle}"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
    <VerticalStackLayout><Label Text="TODAY'S TRAINING" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding TrainingTitle}" Style="{StaticResource SectionTitleStyle}"/><Label Text="{Binding TrainingSummary}" Style="{StaticResource PageSubtitleStyle}"/></VerticalStackLayout>
    <Label Grid.Column="1" Text="{Binding TrainingStatus}" TextColor="#91C4F4" FontAttributes="Bold" CharacterSpacing="1.4" VerticalTextAlignment="Center"/>
    <CollectionView Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Assignments}" EmptyView="NO TRAINING ASSIGNED" MaximumHeightRequest="88"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="0,8" ColumnDefinitions="*,Auto"><Label Text="{Binding Instructions}" Style="{StaticResource SecondaryTextStyle}"/><Label Grid.Column="1" Text="{Binding Drill.Sport}" TextColor="#91C4F4" FontAttributes="Bold"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Button Grid.Row="2" Grid.ColumnSpan="2" Text="OPEN TRAINING" Clicked="QuickActionClicked" CommandParameter="Training" Style="{StaticResource ElitePrimaryButtonStyle}" HorizontalOptions="Start"/>
   </Grid></Border>
   <Label Text="PRIMARY AREAS" Style="{StaticResource PageEyebrowStyle}"/>
   <FlexLayout Wrap="Wrap" JustifyContent="Center" Direction="Row">
    <Button Text="ATHLETE PROFILE" Clicked="QuickActionClicked" CommandParameter="Profile" Style="{StaticResource EliteButtonStyle}" Margin="6" MinimumWidthRequest="190"/>
    <Button Text="TRAINING" Clicked="QuickActionClicked" CommandParameter="Training" Style="{StaticResource EliteButtonStyle}" Margin="6" MinimumWidthRequest="190"/>
    <Button Text="GOALS" Clicked="QuickActionClicked" CommandParameter="Goals" Style="{StaticResource EliteButtonStyle}" Margin="6" MinimumWidthRequest="190"/>
    <Button Text="TROPHY ROOM" Clicked="QuickActionClicked" CommandParameter="Trophy" Style="{StaticResource EliteButtonStyle}" Margin="6" MinimumWidthRequest="190"/>
   </FlexLayout>
  </VerticalStackLayout></ScrollView>
 </Grid>
</ContentPage>
