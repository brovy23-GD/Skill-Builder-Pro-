<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SkillBuilderPro.MAUI.Views.NotificationsPage" Title="Notifications" Shell.NavBarIsVisible="False" BackgroundColor="#08111A">
 <Grid x:Name="NotificationsStage" SizeChanged="NotificationsStageSizeChanged">
  <Image Source="{Binding Background}" Aspect="AspectFill" Opacity="1" ZIndex="-2" HorizontalOptions="Fill" VerticalOptions="Fill"/>
  <BoxView Color="#18050A10" ZIndex="-1"/>
  <Grid x:Name="NotificationsContent" RowDefinitions="Auto,Auto,*" Padding="20" MaximumWidthRequest="900" HorizontalOptions="Center">
   <Border Style="{StaticResource GlassHeaderStyle}"><Grid x:Name="NotificationsHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="10"><VerticalStackLayout x:Name="NotificationTitleGroup" Spacing="1"><Label Text="NOTIFICATIONS" Style="{StaticResource PageTitleStyle}" LineBreakMode="NoWrap" MaxLines="1"/><Label Text="{Binding UnreadCount, StringFormat='{0} unread'}" TextColor="{StaticResource PerformanceBlue}"/></VerticalStackLayout><HorizontalStackLayout x:Name="NotificationActions" Grid.Column="1" Spacing="8"><Button Text="BACK" Clicked="BackClicked" Style="{StaticResource CompactNavButtonStyle}"/><Button Text="EXIT" Clicked="HomeClicked" Style="{StaticResource CompactNavButtonStyle}"/><Button Text="MARK ALL READ" Command="{Binding ReadAllCommand}" Style="{StaticResource GlassSecondaryButtonStyle}"/></HorizontalStackLayout></Grid></Border>
   <Grid Grid.Row="1" ColumnDefinitions="*,Auto"><Label Text="{Binding ErrorMessage}" TextColor="#FF8A8A" VerticalTextAlignment="Center"/><Button Grid.Column="1" Text="RETRY" Command="{Binding LoadCommand}" Style="{StaticResource GlassSecondaryButtonStyle}"/><ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></Grid>
   <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}"><CollectionView ItemsSource="{Binding Items}" EmptyView="You're all caught up." SelectionMode="Single" SelectionChanged="NotificationSelected"><CollectionView.ItemTemplate><DataTemplate><SwipeView><SwipeView.RightItems><SwipeItems><SwipeItem Text="Mark read" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},Path=BindingContext.ReadCommand}" CommandParameter="{Binding .}" BackgroundColor="#168CFF"/></SwipeItems></SwipeView.RightItems><Border Style="{StaticResource GlassListItemStyle}"><Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="10"><BoxView Color="{StaticResource PerformanceBlue}" CornerRadius="4"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold"/><Label Text="{Binding Message}" TextColor="#D6E2EC"/><Label Text="{Binding CreatedAtUtc}" TextColor="{StaticResource MutedText}" FontSize="12"/></VerticalStackLayout><Label Grid.Column="2" Text="NEW" Style="{StaticResource GlassBadgeStyle}" VerticalOptions="Start"/></Grid></Border></SwipeView></DataTemplate></CollectionView.ItemTemplate></CollectionView></RefreshView>
  </Grid>
 </Grid>
</ContentPage>
