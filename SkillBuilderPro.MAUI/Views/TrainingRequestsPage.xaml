<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkillBuilderPro.MAUI.Views.TrainingRequestsPage"
             BackgroundColor="{StaticResource PageBackground}" Title="Requests" Shell.NavBarIsVisible="False">
 <ScrollView><VerticalStackLayout Padding="16,12,16,104" Spacing="16">
  <Border Style="{StaticResource GlassHeaderStyle}"><Grid RowDefinitions="Auto,Auto" RowSpacing="8"><Label Text="TRAINING REQUESTS" Style="{StaticResource PageTitleStyle}"/><HorizontalStackLayout Grid.Row="1" Spacing="8"><Button Text="BACK" Clicked="BackClicked" Style="{StaticResource CompactNavButtonStyle}"/><Button Text="EXIT" Clicked="ExitClicked" Style="{StaticResource CompactNavButtonStyle}"/></HorizontalStackLayout></Grid></Border>
  <Label Text="Request creation is unavailable until an Athlete recipient-discovery API is provided." TextColor="{StaticResource MutedText}"/>
  <CollectionView ItemsSource="{Binding Items}" EmptyView="No training requests yet." MaximumHeightRequest="520"><CollectionView.ItemTemplate><DataTemplate><Border Margin="0,5" Style="{StaticResource GlassCardStyle}"><VerticalStackLayout><Label Text="{Binding Recipient.DisplayName}" TextColor="White" FontAttributes="Bold"/><Label Text="{Binding RecipientRole}" TextColor="{StaticResource MutedText}"/><Label Text="{Binding Status}" TextColor="{StaticResource PerformanceBlue}"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
 </VerticalStackLayout></ScrollView>
</ContentPage>
