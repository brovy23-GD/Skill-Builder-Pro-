<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SkillBuilderPro.MAUI.Views.SportListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Select Sport"
    BackgroundColor="#121212">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Select Sport"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White" />
            <Label Text="{Binding StatusMessage}"
                   FontSize="13"
                   TextColor="Gray" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Sports}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#2E2E2E"
                            StrokeThickness="1"
                            BackgroundColor="#1E1E1E"
                            Padding="16"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectSportCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="12">
                            <Label Text="🏆" FontSize="20" VerticalOptions="Center" />
                            <Label Text="{Binding .}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>