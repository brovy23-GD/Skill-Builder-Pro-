<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SkillBuilderPro.MAUI.Views.TrophyRoomPage" Title="Trophy">
 <Grid x:Name="TrophyStage" SizeChanged="TrophyStageSizeChanged" BackgroundColor="#080C12"><Image Source="trophy_room_background_approved.png" Aspect="AspectFill" Opacity="1" ZIndex="-2" HorizontalOptions="Fill" VerticalOptions="Fill" SemanticProperties.Description="Skill Builder Pro Trophy Room"/><BoxView Color="#1004090E" ZIndex="-1"/>
  <ScrollView><VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="1120" HorizontalOptions="Center">
   <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="ATHLETE LEGACY" Style="{StaticResource PageEyebrowStyle}"/><Label Text="TROPHY ROOM" Style="{StaticResource PageTitleStyle}"/></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center"><Button Text="BACK" Clicked="BackClicked" Style="{StaticResource CompactNavButtonStyle}"/><Button Text="EXIT" Clicked="ExitClicked" Style="{StaticResource CompactNavButtonStyle}"/></HorizontalStackLayout></Grid>
   <Grid x:Name="TrophySummaryGrid" Margin="0,12,0,0" ColumnDefinitions=".9*,1.2*,.9*" ColumnSpacing="16" RowSpacing="12">
    <Border Style="{StaticResource EliteSurfaceStyle}" VerticalOptions="Start"><VerticalStackLayout Spacing="7"><Label Text="CURRENT RANK" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding Room.CurrentProgression.OverallRank}" Style="{StaticResource SectionTitleStyle}"/><Label Text="{Binding Room.CurrentProgression.ProgressToNextRank, StringFormat='{0}% TO NEXT RANK'}" Style="{StaticResource SecondaryTextStyle}"/><ProgressBar Progress="{Binding RankProgress}" ProgressColor="#4D9BE8" BackgroundColor="#303D4B" HeightRequest="5"/><Label Text="{Binding NextRankLabel}" Style="{StaticResource PageSubtitleStyle}"/></VerticalStackLayout></Border>
    <Grid Grid.Column="1" HeightRequest="390"/>
    <Border Grid.Column="2" Style="{StaticResource EliteSurfaceStyle}" VerticalOptions="Start"><VerticalStackLayout Spacing="7"><Label Text="ACHIEVEMENTS" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding AchievementCount}" Style="{StaticResource SectionTitleStyle}"/><Label Text="RECENT UNLOCK" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding RecentUnlock}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout></Border>
   </Grid>
   <Border Style="{StaticResource EliteSurfaceStyle}"><Grid ColumnDefinitions="*,*" ColumnSpacing="24"><VerticalStackLayout><Label Text="SKILL MILESTONES" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding MilestoneCount}" Style="{StaticResource SectionTitleStyle}"/><Label Text="{Binding MilestoneSummary}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="NEXT MILESTONE" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding NextMilestone}" Style="{StaticResource SectionTitleStyle}"/><Label Text="Environmental trophies remain presentation artwork." Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout></Grid></Border>
   <Label Text="RANK JOURNEY" Style="{StaticResource SectionTitleStyle}"/>
   <CollectionView ItemsSource="{Binding Room.RankHistory}" HeightRequest="105" ItemsLayout="HorizontalList"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource EliteSurfaceStyle}" WidthRequest="190" Margin="0,0,10,0"><VerticalStackLayout><Label Text="{Binding RankName}" Style="{StaticResource SectionTitleStyle}"/><Label Text="{Binding ProgressionScoreAtEarned, StringFormat='{0} PROGRESSION POINTS'}" Style="{StaticResource SecondaryTextStyle}"/><Label Text="UNLOCKED" TextColor="#4D9BE8" FontAttributes="Bold" FontSize="11"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
   <Label Text="ACHIEVEMENTS" Style="{StaticResource SectionTitleStyle}"/>
   <CollectionView ItemsSource="{Binding Room.Achievements}" HeightRequest="280"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource EliteSurfaceStyle}" Margin="0,0,0,9"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><Label Text="{Binding Name}" TextColor="#F2F5F8" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding Tier}" TextColor="#91C4F4" FontAttributes="Bold"/><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  </VerticalStackLayout></ScrollView>
 </Grid>
</ContentPage>
