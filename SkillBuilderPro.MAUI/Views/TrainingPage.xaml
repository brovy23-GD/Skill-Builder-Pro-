<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SkillBuilderPro.MAUI.Views.TrainingPage" Title="Training" Shell.NavBarIsVisible="False">
 <Grid x:Name="TrainingStage" SizeChanged="TrainingStageSizeChanged" BackgroundColor="#080C12">
  <Image x:Name="TrainingBackground" Source="{Binding Background}" Aspect="AspectFill" Opacity="1" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" SemanticProperties.Description="Selected Chicago sport environment"/><BoxView BackgroundColor="#14040910" InputTransparent="True"/>
  <ScrollView BackgroundColor="Transparent"><VerticalStackLayout x:Name="TrainingContent" BackgroundColor="Transparent" Padding="22" Spacing="14" MaximumWidthRequest="1120" HorizontalOptions="Center">
   <Border IsVisible="{Binding HasError}" BackgroundColor="#D018202A" Stroke="#5F82A3" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Label Text="{Binding ErrorMessage}" TextColor="#DCE6F0" VerticalTextAlignment="Center"/><Button Grid.Column="1" Text="RETRY" Command="{Binding LoadCommand}" Style="{StaticResource CompactNavButtonStyle}"/></Grid></Border>
   <Border Style="{StaticResource GlassHeaderStyle}"><Grid RowDefinitions="Auto,Auto" RowSpacing="8"><VerticalStackLayout Spacing="1"><Label Text="ATHLETE TRAINING" Style="{StaticResource PageEyebrowStyle}"/><Label Text="TRAINING" Style="{StaticResource PageTitleStyle}"/><Label Text="YOUR TRAINING HUB" Style="{StaticResource PageSubtitleStyle}"/></VerticalStackLayout><HorizontalStackLayout Grid.Row="1" Spacing="8"><Button Text="BACK" Clicked="BackClicked" Style="{StaticResource CompactNavButtonStyle}"/><Button Text="EXIT" Clicked="ExitClicked" Style="{StaticResource CompactNavButtonStyle}"/></HorizontalStackLayout></Grid></Border>
   <Border Style="{StaticResource EliteSurfaceStyle}"><VerticalStackLayout Spacing="8"><Label Text="CURRENT SPORT" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding SelectedSport}" Style="{StaticResource SectionTitleStyle}"/><Picker Title="Change sport" ItemsSource="{Binding Sports}" SelectedItem="{Binding SelectedSport}" Style="{StaticResource ElitePickerStyle}" HorizontalOptions="Fill"/></VerticalStackLayout></Border>
   <Border Style="{StaticResource EliteSurfaceStyle}"><VerticalStackLayout><Label Text="TODAY'S TRAINING" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding TodayTrainingTitle}" Style="{StaticResource SectionTitleStyle}"/><Label Text="{Binding TodayTrainingSummary}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout></Border>
   <FlexLayout Wrap="Wrap" JustifyContent="Center"><Button Text="OPEN TRAINING BUILDER" Clicked="TrainingBuilderClicked" Style="{StaticResource ElitePrimaryButtonStyle}" Margin="6" MinimumWidthRequest="220"/><Button Text="DRILL LIBRARY" Clicked="DrillLibraryClicked" Style="{StaticResource EliteButtonStyle}" Margin="6" MinimumWidthRequest="190"/><Button Text="TRAINING REQUESTS" Clicked="RequestsClicked" Style="{StaticResource EliteButtonStyle}" Margin="6" MinimumWidthRequest="190"/></FlexLayout>
   <Border Style="{StaticResource EliteSurfaceStyle}"><VerticalStackLayout><Label Text="ACTIVE ASSIGNMENTS" Style="{StaticResource SectionTitleStyle}"/><CollectionView ItemsSource="{Binding Active}" EmptyView="NO ACTIVE ASSIGNMENTS" HeightRequest="120"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Drill.Name}" TextColor="White" FontAttributes="Bold"/><Label Text="{Binding Instructions}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding RecipientStatus}" TextColor="#91C4F4" FontAttributes="Bold"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Border>
   <Border Style="{StaticResource EliteSurfaceStyle}"><VerticalStackLayout><Grid ColumnDefinitions="*,Auto"><Label Text="RECENT TRAINING" Style="{StaticResource SectionTitleStyle}"/><Label Grid.Column="1" Text="{Binding Completed.Count, StringFormat='{0} COMPLETED'}" Style="{StaticResource GlassBadgeStyle}"/></Grid><CollectionView ItemsSource="{Binding Completed}" EmptyView="NO COMPLETED TRAINING YET" HeightRequest="110"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnDefinitions="*,Auto"><Label Text="{Binding Drill.Name}" TextColor="White" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding CompletedAtUtc, StringFormat='{0:g}'}" Style="{StaticResource SecondaryTextStyle}"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Border>
  </VerticalStackLayout></ScrollView>
 </Grid>
</ContentPage>
