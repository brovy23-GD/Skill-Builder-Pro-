<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SkillBuilderPro.MAUI.Views.TrainingPage" Title="Training">
 <Grid x:Name="TrainingStage" SizeChanged="TrainingStageSizeChanged" BackgroundColor="#080C12">
  <Image x:Name="TrainingBackground" Source="{Binding Background}" Aspect="AspectFill" Opacity="1" ZIndex="-2" HorizontalOptions="Fill" VerticalOptions="Fill" SemanticProperties.Description="Selected sport training environment"/><BoxView Color="#14040910" ZIndex="-1"/>
  <ScrollView><VerticalStackLayout x:Name="TrainingContent" Padding="22" Spacing="14" MaximumWidthRequest="1120" HorizontalOptions="Center">
   <Border IsVisible="{Binding HasError}" BackgroundColor="#D018202A" Stroke="#5F82A3" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Label Text="{Binding ErrorMessage}" TextColor="#DCE6F0" VerticalTextAlignment="Center"/><Button Grid.Column="1" Text="RETRY" Command="{Binding LoadCommand}" Style="{StaticResource CompactNavButtonStyle}"/></Grid></Border>
   <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="ATHLETE TRAINING" Style="{StaticResource PageEyebrowStyle}"/><Label Text="TRAINING BUILDER" Style="{StaticResource PageTitleStyle}"/><Label Text="BUILD THE WORK. MASTER THE DETAILS." Style="{StaticResource PageSubtitleStyle}"/></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center"><Button Text="BACK" Clicked="BackClicked" Style="{StaticResource CompactNavButtonStyle}"/><Button Text="EXIT" Clicked="ExitClicked" Style="{StaticResource CompactNavButtonStyle}"/></HorizontalStackLayout></Grid>
   <Grid x:Name="TrainingBuilderGrid" ColumnDefinitions=".85*,1.15*" ColumnSpacing="14" RowSpacing="14">
    <Border x:Name="FilterCard" Style="{StaticResource EliteSurfaceStyle}"><VerticalStackLayout Spacing="8"><Label Text="BUILD YOUR SESSION" Style="{StaticResource SectionTitleStyle}"/><Label Text="SPORT" Style="{StaticResource PageEyebrowStyle}"/><Picker Title="Select sport" ItemsSource="{Binding Sports}" SelectedItem="{Binding SelectedSport}" Style="{StaticResource ElitePickerStyle}"/><Label Text="CATEGORY" Style="{StaticResource PageEyebrowStyle}"/><Picker Title="All categories" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource ElitePickerStyle}"/><Label Text="SUBCATEGORY" Style="{StaticResource PageEyebrowStyle}"/><Picker Title="All subcategories" ItemsSource="{Binding SubCategories}" SelectedItem="{Binding SelectedSubCategory}" Style="{StaticResource ElitePickerStyle}"/><Button Text="CLEAR SELECTION" Style="{StaticResource EliteButtonStyle}" Command="{Binding ClearSelectionCommand}"/></VerticalStackLayout></Border>
    <Border x:Name="DrillCard" Grid.Column="1" Style="{StaticResource EliteSurfaceStyle}"><VerticalStackLayout Spacing="9"><Label Text="LIVE DRILLS" Style="{StaticResource SectionTitleStyle}"/><CollectionView ItemsSource="{Binding Drills}" SelectedItem="{Binding SelectedDrill}" SelectionMode="Single" HeightRequest="300" EmptyView="NO DRILLS MATCH THESE FILTERS"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource EliteSurfaceStyle}" Padding="12" Margin="0,0,0,7"><VerticalStackLayout Spacing="2"><Label Text="{Binding Name}" TextColor="#F2F5F8" FontAttributes="Bold"/><Label Text="{Binding Category, StringFormat='{0} DEVELOPMENT'}" TextColor="#91C4F4" FontSize="11" CharacterSpacing="1"/><Label Text="{Binding SubCategory}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Border BackgroundColor="#70182635" Stroke="#4D9BE8" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12"><VerticalStackLayout Spacing="3"><Label Text="SELECTED DRILL" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding SelectedDrill.Name}" Style="{StaticResource SectionTitleStyle}"/><Label Text="{Binding SelectedDrill.Description}" Style="{StaticResource SecondaryTextStyle}"/><Label Text="{Binding SelectedDrill.Duration, StringFormat='ESTIMATED  {0}'}" Style="{StaticResource PageSubtitleStyle}"/></VerticalStackLayout></Border><Button Text="OPEN TRAINING VIDEO" Style="{StaticResource ElitePrimaryButtonStyle}" Clicked="VideoClicked"/></VerticalStackLayout></Border>
   </Grid>
   <Border Style="{StaticResource EliteSurfaceStyle}"><VerticalStackLayout><Grid ColumnDefinitions="*,Auto"><Label Text="ACTIVE ASSIGNMENTS" Style="{StaticResource SectionTitleStyle}"/><Button Grid.Column="1" Text="REQUESTS" Style="{StaticResource EliteButtonStyle}" Clicked="RequestsClicked"/></Grid><CollectionView ItemsSource="{Binding Active}" EmptyView="NO ACTIVE ASSIGNMENTS" HeightRequest="90"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnDefinitions="*,Auto"><Label Text="{Binding Instructions}" Style="{StaticResource SecondaryTextStyle}"/><Label Grid.Column="1" Text="{Binding RecipientStatus}" TextColor="#91C4F4" FontAttributes="Bold"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Border>
  </VerticalStackLayout></ScrollView>
 </Grid>
</ContentPage>
