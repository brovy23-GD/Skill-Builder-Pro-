<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:services="clr-namespace:SkillBuilderPro.MAUI.Services" x:Class="SkillBuilderPro.MAUI.Views.GoalsPage" Title="Goals" Shell.NavBarIsVisible="False">
 <ContentPage.Resources><services:PercentageToProgressConverter x:Key="PercentageToProgress"/></ContentPage.Resources>
 <Grid BackgroundColor="#080C12"><Image Source="goals_background_approved.png" Aspect="AspectFill" Opacity="1" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" SemanticProperties.Description="Goals and progress environment"/><BoxView BackgroundColor="#14050A10" InputTransparent="True"/>
  <ScrollView BackgroundColor="Transparent"><VerticalStackLayout BackgroundColor="Transparent" Padding="16,12,16,104" Spacing="16" MaximumWidthRequest="1080" HorizontalOptions="Center">
   <Border Style="{StaticResource GlassHeaderStyle}"><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="8"><VerticalStackLayout Spacing="1"><Label Text="ATHLETE DEVELOPMENT" Style="{StaticResource PageEyebrowStyle}"/><Label Text="GOALS &amp; PROGRESS" Style="{StaticResource PageTitleStyle}"/><Label Text="SET IT. CHASE IT. ACHIEVE IT." Style="{StaticResource PageSubtitleStyle}"/></VerticalStackLayout><HorizontalStackLayout Grid.Row="1" Spacing="8"><Button Text="BACK" Clicked="BackClicked" Style="{StaticResource CompactNavButtonStyle}"/><Button Text="EXIT" Clicked="ExitClicked" Style="{StaticResource CompactNavButtonStyle}"/></HorizontalStackLayout></Grid></Border>
   <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10"><Border Style="{StaticResource EliteMetricStyle}"><VerticalStackLayout><Label Text="CURRENT RANK" Style="{StaticResource HomeMetricLabelStyle}"/><Label Text="{Binding Progression.OverallRank}" Style="{StaticResource HomeMetricValueStyle}"/></VerticalStackLayout></Border><Border Grid.Column="1" Style="{StaticResource EliteMetricStyle}"><VerticalStackLayout><Label Text="STREAK" Style="{StaticResource HomeMetricLabelStyle}"/><Label Text="{Binding Progression.CurrentStreak, StringFormat='{0} DAYS'}" Style="{StaticResource HomeMetricValueStyle}"/></VerticalStackLayout></Border><Border Grid.Row="1" Style="{StaticResource EliteMetricStyle}"><VerticalStackLayout><Label Text="ACTIVE GOALS" Style="{StaticResource HomeMetricLabelStyle}"/><Label Text="{Binding Active.Count}" Style="{StaticResource HomeMetricValueStyle}"/></VerticalStackLayout></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource EliteMetricStyle}"><VerticalStackLayout><Label Text="PROGRESS" Style="{StaticResource HomeMetricLabelStyle}"/><Label Text="{Binding Focus.ProgressPercent, StringFormat='{0}%'}" Style="{StaticResource HomeMetricValueStyle}"/></VerticalStackLayout></Border></Grid>
   <Label Text="ACTIVE GOALS" Style="{StaticResource SectionTitleStyle}" BackgroundColor="#A80C121A" Padding="10,6" HorizontalOptions="Start"/>
   <CollectionView ItemsSource="{Binding Active}" EmptyView="NO ACTIVE GOALS&#10;Build your next target and start tracking progress." MaximumHeightRequest="470"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource EliteSurfaceStyle}" Margin="0,0,0,10"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="7"><Label Text="{Binding Title}" TextColor="#F2F5F8" FontSize="16" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{0}%'}" TextColor="#91C4F4" FontAttributes="Bold"/><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}"/><ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Progress="{Binding ProgressPercent, Converter={StaticResource PercentageToProgress}}" ProgressColor="#4D9BE8" BackgroundColor="#303D4B" HeightRequest="5"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
   <Grid ColumnDefinitions="*,Auto"><Label Text="COMPLETED GOALS" Style="{StaticResource SectionTitleStyle}" BackgroundColor="#A80C121A" Padding="10,6" HorizontalOptions="Start"/><Button Grid.Column="1" Text="MILESTONES" Clicked="GoalsNavigationClicked" CommandParameter="Trophy" Style="{StaticResource EliteButtonStyle}"/></Grid>
   <CollectionView ItemsSource="{Binding Completed}" EmptyView="COMPLETED GOALS WILL APPEAR HERE" MaximumHeightRequest="120"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource EliteSurfaceStyle}" Padding="10" Margin="0,0,0,8"><Label Text="{Binding Title}" Style="{StaticResource SecondaryTextStyle}"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  </VerticalStackLayout></ScrollView>
 </Grid>
</ContentPage>
