<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SkillBuilderPro.MAUI.Views.ProfilePage" Title="Profile" Shell.NavBarIsVisible="False">
 <Grid BackgroundColor="#080C12">
  <Image Source="locker_room_background_approved.png" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" SemanticProperties.Description="Skill Builder Pro personal locker room"/>
  <BoxView BackgroundColor="#2004090E" InputTransparent="True"/>
  <Grid x:Name="ProfileContent" BackgroundColor="Transparent" Padding="20" MaximumWidthRequest="1080" HorizontalOptions="Center">
   <Button Text="{Binding ExitLabel}" Command="{Binding LogoutCommand}" Style="{StaticResource CompactNavButtonStyle}" HorizontalOptions="End" VerticalOptions="Start" ZIndex="3" AutomationId="ProfileSignOutButton"/>
   <Border x:Name="ProfilePanel" IsVisible="False" Opacity="0" BackgroundColor="#0D141D" Stroke="#4A6B849F" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20" MaximumWidthRequest="900">
    <ScrollView><VerticalStackLayout Spacing="16">
     <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="ATHLETE DOSSIER" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding DisplayName}" Style="{StaticResource PageTitleStyle}" TextTransform="Uppercase"/><Label Text="{Binding Status}" Style="{StaticResource PageSubtitleStyle}"/></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center"><Button Text="BACK" Clicked="ProfileBackClicked" Style="{StaticResource CompactNavButtonStyle}"/><Button Text="EXIT" Clicked="ProfileExitClicked" Style="{StaticResource CompactNavButtonStyle}"/></HorizontalStackLayout></Grid>
     <Grid x:Name="PlayerCardGrid" ColumnDefinitions="220,*" ColumnSpacing="18" RowSpacing="14">
      <Border BackgroundColor="#78161E29" Stroke="#4A6B849F" StrokeShape="RoundRectangle 10" HeightRequest="230"><Grid><Label x:Name="PhotoPlaceholder" Text="AR" FontSize="58" FontAttributes="Bold" TextColor="#7F91A5" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/><Image x:Name="AthletePhoto" Aspect="AspectFill" SemanticProperties.Description="Athlete profile photo"/></Grid></Border>
      <VerticalStackLayout Grid.Column="1" Spacing="10"><Label Text="PLAYER CARD" Style="{StaticResource SectionTitleStyle}"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="12"><VerticalStackLayout><Label Text="PRIMARY SPORT" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding Sport}" Style="{StaticResource HomeMetricValueStyle}" HorizontalTextAlignment="Start"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="LOCKER NUMBER" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding LockerNumber}" Style="{StaticResource HomeMetricValueStyle}" HorizontalTextAlignment="Start"/></VerticalStackLayout><VerticalStackLayout Grid.Row="1"><Label Text="DEVELOPMENT FOCUS" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding Focus}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout><VerticalStackLayout Grid.Row="1" Grid.Column="1"><Label Text="SKILL LEVEL" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding SkillLevel}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout><VerticalStackLayout Grid.Row="2"><Label Text="TEAM" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding Team}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout><VerticalStackLayout Grid.Row="2" Grid.Column="1"><Label Text="ROLE" Style="{StaticResource HomeMetricLabelStyle}" HorizontalTextAlignment="Start"/><Label Text="{Binding Role}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout></Grid><Button Text="CHANGE PHOTO" Clicked="ChangePhotoClicked" Style="{StaticResource EliteButtonStyle}" HorizontalOptions="Start"/></VerticalStackLayout>
     </Grid>
     <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween">
      <Border Style="{StaticResource EliteMetricStyle}" Margin="0,0,8,8"><VerticalStackLayout><Label Text="CURRENT RANK" Style="{StaticResource HomeMetricLabelStyle}"/><Label Text="{Binding Progression.OverallRank}" Style="{StaticResource HomeMetricValueStyle}"/></VerticalStackLayout></Border>
      <Border Style="{StaticResource EliteMetricStyle}" Margin="0,0,8,8"><VerticalStackLayout><Label Text="STREAK" Style="{StaticResource HomeMetricLabelStyle}"/><Label Text="{Binding Progression.CurrentStreak, StringFormat='{0} DAYS'}" Style="{StaticResource HomeMetricValueStyle}"/></VerticalStackLayout></Border>
      <Border Style="{StaticResource EliteMetricStyle}" Margin="0,0,8,8"><VerticalStackLayout><Label Text="ACTIVE GOALS" Style="{StaticResource HomeMetricLabelStyle}"/><Label Text="{Binding ActiveGoalCount}" Style="{StaticResource HomeMetricValueStyle}"/></VerticalStackLayout></Border>
      <Border Style="{StaticResource EliteMetricStyle}" Margin="0,0,8,8"><VerticalStackLayout><Label Text="NEXT MILESTONE" Style="{StaticResource HomeMetricLabelStyle}"/><Label Text="{Binding NextMilestone}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout></Border>
     </FlexLayout>
     <Grid x:Name="ContactBioGrid" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12"><Border x:Name="ContactCard" Style="{StaticResource EliteSurfaceStyle}"><VerticalStackLayout><Label Text="CONTACT" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding Email}" Style="{StaticResource SecondaryTextStyle}"/><Label Text="{Binding Phone}" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout></Border><Border x:Name="BioCard" Grid.Column="1" Style="{StaticResource EliteSurfaceStyle}"><VerticalStackLayout><Label Text="ATHLETE BIO" Style="{StaticResource PageEyebrowStyle}"/><Label Text="{Binding Bio}" Style="{StaticResource SecondaryTextStyle}" LineBreakMode="WordWrap" MaxLines="5"/></VerticalStackLayout></Border></Grid>
     <HorizontalStackLayout Spacing="8"><Button Text="EDIT PROFILE" IsEnabled="False" Style="{StaticResource EliteButtonStyle}"/><Button Text="{Binding ExitLabel}" Command="{Binding LogoutCommand}" Style="{StaticResource EliteButtonStyle}"/></HorizontalStackLayout>
    </VerticalStackLayout></ScrollView>
   </Border>
   <Border x:Name="LockerDoorContainer" WidthRequest="408" HeightRequest="544" SizeChanged="LockerDoorSizeChanged" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent" Stroke="Transparent" SemanticProperties.Description="Open your locker and view athlete profile.">
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="LockerTapped"/></Border.GestureRecognizers>
    <AbsoluteLayout><Image Source="locker_door_dynamic_approved.png" Aspect="AspectFit" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All"/><Label x:Name="LockerNameLabel" Text="{Binding DisplayName}" TextColor="#E8EDF3" BackgroundColor="#A8101419" FontSize="12" FontAutoScalingEnabled="False" FontAttributes="Bold" CharacterSpacing=".7" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation" Padding="4,0"/><Label x:Name="LockerNumberLabel" Text="{Binding LockerNumber}" IsVisible="{Binding HasLockerNumber}" TextColor="#3FA9FF" BackgroundColor="Transparent" FontSize="66" FontAutoScalingEnabled="False" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"><Label.Shadow><Shadow Brush="#D00069C7" Offset="0,3" Radius="5" Opacity="0.9"/></Label.Shadow></Label></AbsoluteLayout>
   </Border>
  </Grid>
 </Grid>
</ContentPage>
